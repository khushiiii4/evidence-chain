# ── Blockchain ─────────────────────────────────────────────
# Address printed after local deploy: npm run deploy (inside /blockchain)
CONTRACT_ADDRESS=0xYourLocalDeployedContractAddress

# ── Pinata IPFS ────────────────────────────────────────────
# Get your JWT from https://app.pinata.cloud → API Keys → New Key
PINATA_JWT=your_pinata_jwt_token_here

# ── Server ─────────────────────────────────────────────────
PORT=5000
